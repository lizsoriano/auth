{
  "info": {
    "name": "pagos Â· Library",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configura variables locales. Ejecuta manualmente con datos de prueba; las escrituras cambian datos. JWT desde login. Para pagos conserva la clave al reintentar."
  },
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health?format=json"
      }
    },
    {
      "name": "GET /metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/metrics?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "POST /pagos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{base_url}}/pagos?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": {{order_id}},\n  \"method\": \"transferencia\",\n  \"amount\": \"{{amount}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /pagos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pagos?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "GET /pagos/<int:payment_id>",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pagos/{{payment_id}}?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "PUT /pagos/<payment_id> (405 con JWT)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{base_url}}/pagos/{{payment_id}}?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pagos inmutables (405)\", () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH /pagos/<payment_id> (405 con JWT)",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{base_url}}/pagos/{{payment_id}}?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pagos inmutables (405)\", () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /pagos/<payment_id> (405 con JWT)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/pagos/{{payment_id}}?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pagos inmutables (405)\", () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5005"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "author_id",
      "value": "1"
    },
    {
      "key": "order_id",
      "value": "1"
    },
    {
      "key": "payment_id",
      "value": "1"
    },
    {
      "key": "isbn",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "current_password",
      "value": ""
    },
    {
      "key": "amount",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    }
  ]
}

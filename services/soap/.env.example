FLASK_ENV=development
SOAP_HOST=127.0.0.1
SOAP_PORT=5000
DATABASE_URL=postgresql://soap_service_user:CAMBIAR@localhost:5432/library_db
# Solo para scripts/crear_credencial_reportes.py: soap_service_user es de
# solo lectura en soap_service_credenciales a propósito (ver
# sql/soap_module.sql), así que este script necesita una conexión aparte
# con privilegios de escritura, típicamente el superusuario que aplicó
# sql/soap_module.sql. El servicio en ejecución (app.py) NUNCA usa esta
# variable, solo DATABASE_URL.
ADMIN_DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/library_db
LOG_LEVEL=INFO
WSSE_NONCE_WINDOW_SECONDS=300
# Clave maestra para cifrar/descifrar las contraseñas de WS-Security
# guardadas en soap_service_credenciales.password_cifrada (Fernet, paquete
# `cryptography`). NUNCA commitear el valor real; generar una propia con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WSSE_MASTER_KEY=

# --- JWT (lo emite services/login en POST /login; AQUÍ SOLO SE VALIDA) ---
# HS256. Mínimo 32 caracteres. DEBE ser exactamente la misma cadena en TODOS los servicios (login, books, users,
# authors, pedidos, pagos). Solo vive en variables de entorno: nunca en el código ni en el repositorio.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ISSUER=library-login

# --- Redis (revocación de JWT, caché de /books) ---
# URL común protegida con contraseña: redis://:PASSWORD@host:6379/0   (deploy/setup_redis_vm.sh la configura)
REDIS_URL=redis://:CAMBIAR@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
# TTL (segundos) de books:list:all y books:<isbn>. Corto a propósito: acota lo desactualizada que puede quedar la caché.
CACHE_TTL_SECONDS=60

# --- CORS: SOLO los orígenes de las aplicaciones cliente en producción (separados por coma; vacío = desactivado) ---
CORS_ORIGINS=

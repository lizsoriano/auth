    {
      "name": "2 · Registro (envía el correo por Postfix)",
      "item": [
        {
          "name": "POST /register (sin format => XML)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido_paterno\": \"López\",\n  \"apellido_materno\": \"Díaz\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", \"postman_\" + Date.now() + \"@\" + pm.variables.get(\"email_domain\"));",
                  "pm.collectionVariables.set(\"verify_token\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Content-Type XML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/xml\"));",
                  "pm.test(\"cuerpo contiene <email>\", () => pm.expect(pm.response.text()).to.include(\"<email>\"));",
                  "pm.test(\"cuerpo contiene <email_verified>false</email_verified>\", () => pm.expect(pm.response.text()).to.include(\"<email_verified>false</email_verified>\"));",
                  "pm.test(\"verification_email = sent (Postfix acepto el mensaje)\", () => pm.expect(pm.response.text()).to.include(\"<verification_email>sent</verification_email>\"));",
                  "pm.test(\"nunca devuelve password/hash\", () => pm.expect(pm.response.text()).to.not.match(/password/i));"
                ]
              }
            }
          ]
        },

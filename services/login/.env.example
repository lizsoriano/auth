# Copia a .env y ajusta. NUNCA subas .env al repositorio.

# --- Servidor ---
# 127.0.0.1 = solo local. Usa 0.0.0.0 para recibir tráfico de otras máquinas (Postman desde tu PC).
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Obligatoria, mínimo 16 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- PostgreSQL (base de datos existente de la librería) ---
# Rol dedicado de este servicio (mínimo privilegio), ver ../../data/migrations/000_create_role.sql
# La BD real del proyecto se llama library_db (no 'library').
DATABASE_URL=postgresql://login_service_user:CAMBIAR@localhost:5432/library_db
DB_CONNECT_TIMEOUT=5

# --- Sesión ---
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_LIFETIME_HOURS=24
SESSION_COOKIE_NAME=login_session
# true cuando se sirva por HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# --- Registro ---
MIN_PASSWORD_LENGTH=8
# Costo de bcrypt. 12 = el mismo del monolito. No lo bajes en producción.
BCRYPT_ROUNDS=12
# true = además de validar el formato, consulta DNS (MX) del dominio del correo
EMAIL_CHECK_DELIVERABILITY=false

# --- Confirmación del correo (envío por el Postfix de la instancia: postfix.service, localhost:25) ---
# false = sin correo (solo desarrollo): las cuentas nuevas pueden iniciar sesión de inmediato.
EMAIL_CONFIRMATION_REQUIRED=true
# Remitente. Obligatorio si la confirmación está activa. Con relay por Gmail debe ser tu cuenta de Gmail.
MAIL_FROM=Library <no-reply@tu-dominio.com>
# Base del enlace que recibe el usuario; debe abrirse desde SU navegador (IP/dominio público de la VM).
PUBLIC_BASE_URL=http://IP-PUBLICA-DE-LA-VM:5000
SMTP_HOST=localhost
SMTP_PORT=25
# Solo si usaras un SMTP remoto en vez de Postfix local:
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TOKEN_TTL_HOURS=24
RESEND_COOLDOWN_SECONDS=60

# --- CORS (orígenes separados por coma; vacío = CORS desactivado) ---
CORS_ORIGINS=

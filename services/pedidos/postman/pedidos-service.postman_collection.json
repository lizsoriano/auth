{
  "info": {
    "name": "pedidos · Library",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configura variables locales. Ejecuta manualmente con datos de prueba; las escrituras cambian datos. JWT desde login. Para pagos conserva la clave al reintentar."
  },
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health?format=json"
      }
    },
    {
      "name": "GET /metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/metrics?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "POST /pedidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/pedidos?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"isbn\": \"{{isbn}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET /pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pedidos?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "GET /pedidos/<int:order_id>",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pedidos/{{order_id}}?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "PATCH /pedidos/<int:order_id>/status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/pedidos/{{order_id}}/status?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "DELETE /pedidos/<int:order_id>",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/pedidos/{{order_id}}?format=json",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5004"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "author_id",
      "value": "1"
    },
    {
      "key": "order_id",
      "value": "1"
    },
    {
      "key": "payment_id",
      "value": "1"
    },
    {
      "key": "isbn",
      "value": ""

{
  "info": {
    "name": "authors · Library",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configura variables locales. Ejecuta manualmente con datos de prueba; las escrituras cambian datos. JWT desde login. Para pagos conserva la clave al reintentar."
  },
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health?format=json"
      }
    },
    {
      "name": "GET /metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/metrics?format=json"
      }
    },
    {
      "name": "GET /authors",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/authors?format=json"
      }
    },
    {
      "name": "GET /authors/<int:author_id>",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/authors/{{author_id}}?format=json"
      }
    },
    {
      "name": "GET /authors/<int:author_id>/books",
      "request": {
        "method": "GET",
        "header": [],

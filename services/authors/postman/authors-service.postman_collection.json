        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Prueba\",\n  \"last_name\": \"Local\",\n  \"biography\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }

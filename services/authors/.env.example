# Copia a .env y ajusta. NUNCA subas .env al repositorio.

# --- Servidor ---
# 127.0.0.1 = solo local (nginx es la única entrada pública). Usa 0.0.0.0 solo para pruebas desde otra máquina.
FLASK_HOST=127.0.0.1
FLASK_PORT=5003
LOG_LEVEL=INFO

# --- PostgreSQL (base compartida library_db) ---
# Rol dedicado de este servicio (mínimo privilegio): solo puede ejecutar sus funciones fn_authors_* (ver data/migrations/008_users_authors_functions.sql).
DATABASE_URL=postgresql://authors_service_user:CAMBIAR@localhost:5432/library_db
DB_CONNECT_TIMEOUT=5

# --- JWT (lo emite services/login en POST /login; AQUÍ SOLO SE VALIDA) ---
# HS256. Mínimo 32 caracteres. DEBE ser exactamente la misma cadena en TODOS los servicios. Solo vive en variables
# de entorno (este archivo es de la máquina, no del repositorio):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ISSUER=library-login

# --- Redis (revocación de JWT, caché de /authors e invalidación de books:*) ---
# URL común protegida con contraseña: redis://:PASSWORD@host:6379/0   (deploy/setup_microservices_vm.sh la configura)
REDIS_URL=redis://:CAMBIAR@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
CACHE_TTL_SECONDS=60

# --- CORS: SOLO los orígenes de las aplicaciones cliente en producción (separados por coma; vacío = desactivado) ---
CORS_ORIGINS=

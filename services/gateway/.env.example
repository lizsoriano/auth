# API Gateway de Library. Todas las variables son opcionales: los valores por defecto son los de la VM.
# OJO: systemd (EnvironmentFile) NO admite comentarios en la misma linea que el valor; van siempre en su propia linea.

# Solo loopback: la unica puerta publica es Nginx.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Segundos para abrir conexion con un servicio.
GATEWAY_CONNECT_TIMEOUT=3
# Segundos esperando su respuesta (504 si se pasa).
GATEWAY_READ_TIMEOUT=30
# 413 si el cuerpo de una peticion es mayor.
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_LOG_LEVEL=INFO

# Direcciones de los servicios (en la VM todos viven en 127.0.0.1):
# AUTH_URL=http://127.0.0.1:5000
# SOAP_URL=http://127.0.0.1:5001
# USERS_URL=http://127.0.0.1:5002
# AUTHORS_URL=http://127.0.0.1:5003
# PEDIDOS_URL=http://127.0.0.1:5004
# PAGOS_URL=http://127.0.0.1:5005
# GPS_URL=http://127.0.0.1:5900
# LIBRARY_URL=http://127.0.0.1:3000

[Unit]
Description=Library SOAP service (gunicorn, puerto 5001, loopback)
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
User=rutil
WorkingDirectory=/opt/library_soap_service
Environment=SOAP_PORT=5001
Environment=FLASK_ENV=production
Environment=FLASK_DEBUG=0
ExecStart=/opt/library_soap_service/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5001 app:create_app()
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Library users service (Flask + gunicorn, puerto 5002, loopback)
After=network.target postgresql.service redis.service
Wants=redis.service

[Service]
User=rutil
WorkingDirectory=/opt/auth/services/users
ExecStart=/opt/auth/services/users/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5002 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
